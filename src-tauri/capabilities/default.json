{
  "identifier": "default",
  "description": "E.D.I.T.H. default capability set",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "edith-desktop-loopback",
    "core:window:allow-inner-position",
    "core:window:allow-scale-factor"
  ]
}
