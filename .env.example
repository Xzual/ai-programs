# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_DEFAULT_MODEL="gemini-2.5-flash"
# GEMINI_API_BASE_URL: Optional. Leave unset unless routing Gemini through a trusted compatible endpoint.
# GEMINI_API_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# E.D.I.T.H. Obsidian knowledge vault. This is not a secret.
OBSIDIAN_VAULT_PATH="D:\\EDİTH\\EDİTH"
EDITH_OBSIDIAN_ENABLED=true
EDITH_OBSIDIAN_MODE=read_write_safe
EDITH_KNOWLEDGE_MAP_OBSIDIAN=true
EDITH_OBSIDIAN_BACKLINKS=true
EDITH_OBSIDIAN_INDEX=true
EDITH_OBSIDIAN_DAILY_NOTES=true
EDITH_KNOWLEDGE_GRAPH_AUTOSYNC=true
