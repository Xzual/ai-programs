# AI provider system. API keys are backend-only and must never be stored in frontend localStorage.
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_HEALTH_TIMEOUT_MS=15000
GEMINI_TIMEOUT_MS=30000

OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=
OLLAMA_HEALTH_TIMEOUT_MS=3000
OLLAMA_FIRST_TOKEN_TIMEOUT_MS=15000
OLLAMA_GENERATION_TIMEOUT_MS=60000

AI_PROVIDER_MODE=auto
AI_FALLBACK_ENABLED=true
AI_DEFAULT_PROVIDER=ollama

# Backend owner-session boundary. Generate a strong random value locally and never expose it through VITE_*.
EDITH_OWNER_TOKEN=
EDITH_OWNER_SESSION_TTL_MS=28800000

# Local-only by default. Non-loopback binding requires EDITH_ALLOW_REMOTE_BIND=true explicitly.
EDITH_HOST=127.0.0.1
EDITH_ALLOW_REMOTE_BIND=false

# Optional account and metadata registry. Both values remain backend-only.
# Use the public anonymous key with Row Level Security; the service-role key is not used by E.D.I.T.H.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_TIMEOUT_MS=6000
# E.D.I.T.H. Obsidian knowledge vault. This is not a secret.
EDITH_WORKSPACE_ROOT=""
EDITH_WORKSPACE_CONFIG_PATH=""
OBSIDIAN_VAULT_PATH=""
EDITH_OBSIDIAN_ENABLED=true
EDITH_OBSIDIAN_MODE=read_write_safe
EDITH_KNOWLEDGE_MAP_OBSIDIAN=true
EDITH_OBSIDIAN_BACKLINKS=true
EDITH_OBSIDIAN_INDEX=true
EDITH_OBSIDIAN_DAILY_NOTES=true
EDITH_KNOWLEDGE_GRAPH_AUTOSYNC=true

# E.D.I.T.H. local startup manager.
# npm run edith:dev:full forces crypto observer mode and keeps all trading flags disabled.
# Keep autostart false for normal npm run dev unless you intentionally use the full startup manager.
EDITH_CRYPTO_AUTOSTART=false
EDITH_CRYPTO_SERVICE_URL="http://localhost:5000"
EDITH_CRYPTO_DASHBOARD_URL="http://localhost:5000"
# Crypto safety defaults. Do not change these to enable trading from startup scripts.
CRYPTO_MODE=OBSERVER_ONLY
TRADING_MODE=OBSERVER_ONLY
CRYPTO_TRADING_ENABLED=false
CRYPTO_PAPER_TRADING_ENABLED=false
CRYPTO_LIVE_TRADING_ENABLED=false
ENABLE_LIVE_TRADING=false
BINANCE_TRADING_ENABLED=false
CRYPTO_DEMO_TRADING_ENABLED=true
CRYPTO_STARTING_BALANCE=10000
CRYPTO_DECISION_MODEL=jev
CRYPTO_OBSIDIAN_ENABLED=false
CRYPTO_LEARNING_ENABLED=false
CRYPTO_NEWS_ENABLED=false
CRYPTO_OLLAMA_ENABLED=false

# Jev is a backend-only decision API. Never expose JEV_API_KEY to Vite/frontend variables.
# Native TypeSafe Jev: https://api.typesafe.ai (adapter calls /v1/systemone).
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
# Use typesafe for native System One. openai_chat and direct are optional gateway modes.
JEV_API_STYLE=typesafe
JEV_TIMEOUT_SECONDS=20
# Continuous demo decisions run only after the user presses Start.
CRYPTO_JEV_LOOP_INTERVAL_SECONDS=60
CRYPTO_JEV_LOOP_MIN_INTERVAL_SECONDS=10
CRYPTO_MAX_MARKET_DATA_AGE_MS=15000
CRYPTO_MARKET_CACHE_SECONDS=5
CRYPTO_OPERATION_LEASE_SECONDS=120
# Optional separate port for an isolated demo test service.
CRYPTO_PORT=5000

# Never commit real API keys, Binance secrets, tokens, or private credentials.
