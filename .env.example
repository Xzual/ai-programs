# AI provider system. API keys are backend-only and must never be stored in frontend localStorage.
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_HEALTH_TIMEOUT_MS=15000
GEMINI_TIMEOUT_MS=30000

OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=
OLLAMA_HEALTH_TIMEOUT_MS=3000
OLLAMA_FIRST_TOKEN_TIMEOUT_MS=15000
OLLAMA_GENERATION_TIMEOUT_MS=60000

AI_PROVIDER_MODE=auto
AI_FALLBACK_ENABLED=true
AI_DEFAULT_PROVIDER=ollama
# E.D.I.T.H. Obsidian knowledge vault. This is not a secret.
OBSIDIAN_VAULT_PATH="D:\\EDİTH\\EDİTH"
EDITH_OBSIDIAN_ENABLED=true
EDITH_OBSIDIAN_MODE=read_write_safe
EDITH_KNOWLEDGE_MAP_OBSIDIAN=true
EDITH_OBSIDIAN_BACKLINKS=true
EDITH_OBSIDIAN_INDEX=true
EDITH_OBSIDIAN_DAILY_NOTES=true
EDITH_KNOWLEDGE_GRAPH_AUTOSYNC=true

# E.D.I.T.H. local startup manager.
# npm run edith:dev:full forces crypto observer mode and keeps all trading flags disabled.
# Keep autostart false for normal npm run dev unless you intentionally use the full startup manager.
EDITH_CRYPTO_AUTOSTART=false
EDITH_CRYPTO_SERVICE_URL="http://localhost:5000"
EDITH_CRYPTO_DASHBOARD_URL="http://localhost:5000"
# Crypto safety defaults. Do not change these to enable trading from startup scripts.
CRYPTO_MODE=OBSERVER_ONLY
TRADING_MODE=OBSERVER_ONLY
CRYPTO_TRADING_ENABLED=false
CRYPTO_PAPER_TRADING_ENABLED=false
CRYPTO_LIVE_TRADING_ENABLED=false
ENABLE_LIVE_TRADING=false
BINANCE_TRADING_ENABLED=false

# Never commit real API keys, Binance secrets, tokens, or private credentials.
