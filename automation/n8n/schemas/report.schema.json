{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EDITH Specialist Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "chat", "status", "summary", "files_changed", "tests_run", "tests_passed", "tests_failed", "known_risks", "blockers", "next_step", "commit_hash", "push_status"],
  "properties": {
    "task_id": { "type": "string" },
    "chat": { "enum": ["0", "2", "4", "5", "6", "7", "8"] },
    "status": { "enum": ["completed", "failed", "blocked", "needs_fix"] },
    "summary": { "type": "string" },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "tests_run": { "type": "array", "items": { "type": "string" } },
    "tests_passed": { "type": "array", "items": { "type": "string" } },
    "tests_failed": { "type": "array", "items": { "type": "string" } },
    "known_risks": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "next_step": { "type": "string" },
    "commit_hash": { "type": ["string", "null"] },
    "reported_commit_reference": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "push_status": { "enum": ["not_started", "skipped", "pushed", "failed", "blocked"] }
  }
}
